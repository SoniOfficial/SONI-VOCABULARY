<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#100B20</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.Normal</item>
    </style>

    <style name="AppTheme.Normal" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#100B20</item>
        <item name="android:colorAccent">#9B72FF</item>
        <item name="android:statusBarColor">#100B20</item>
        <item name="android:navigationBarColor">#100B20</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
